{
  "name": "mdbisync",
  "version": "0.0.0",
  "private": true,
  "description": "Two-way sync between Markdown files in a Git repository and Linear documents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "bin": {
    "mdbisync": "dist/cli.js"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "tsc --noEmit",
    "test:hooks": "node tools/test-hooks.ts",
    "test:template-install": "node tools/test-template-install.ts",
    "test": "node --test \"src/**/*.test.ts\" \"tools/**/*.test.ts\" \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "check:install-scripts": "node tools/check-install-scripts.ts",
    "check:cyrillic": "node tools/check-no-cyrillic.ts",
    "check:fixtures": "node test/fixtures/check-index.mjs",
    "probe:format": "node test/probe/run.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@linear/sdk": "99.0.0",
    "decode-named-character-reference": "1.3.0",
    "gemoji": "8.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-sanitize-uri": "2.0.1",
    "saxes": "6.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yjs": "13.6.33"
  }
}
