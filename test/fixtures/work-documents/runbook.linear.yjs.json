    {
      "type": "ordered_list",
      "attrs": {
        "order": 1
      },
      "children": [
        {
          "type": "list_item",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "text": "Pause new jobs:",
                  "marks": {
                    "attribution": {
                      "actorType": "user",
                      "userId": "<userId>"
                    }
                  }
                }
              ]
            },
            {
              "type": "code_block",
              "attrs": {
                "id": "<id>",
                "language": "sh"
              },
              "children": [
                {
                  "text": "worker pause",
