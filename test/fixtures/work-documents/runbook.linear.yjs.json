                    "attribution": {
                      "actorType": "user",
                      "userId": "<userId>"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "list_item",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "text": "Wait until the queue is empty.",
